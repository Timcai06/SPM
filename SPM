#!/usr/bin/env bash
set -euo pipefail

show_help() {
  cat <<'EOF'
Usage:
  ./SPM <group> <command> [MAKE_VAR=VALUE ...]
  ./SPM <shortcut> [MAKE_VAR=VALUE ...]

Primary groups:
  workflow  full | trial
  ingest    live | history | backfill | full
  event     run | pending | reclassify | canonicalize
  link      run | universe | standard-industries | board-industries | stats | profiles | market | sentiment
  graph     run | load | propagate
  research  feature | train | controls
  status    summary | sample | db | storage | sources | raw | delivery | check | clean-stage

Primary shortcuts:
  full          -> workflow full
  history       -> ingest history
  backfill      -> ingest backfill
  event         -> event run
  train         -> research train
  controls      -> research controls
  summary       -> status summary
  db            -> status db
  storage       -> status storage
  sources       -> status sources
  raw           -> status raw
  clean-stage   -> status clean-stage

Legacy aliases:
  Older names are still accepted for compatibility, but are intentionally hidden here.

Examples:
  ./SPM ingest history HISTORY_SOURCE=cninfo-disclosure HISTORY_CNINFO_FULLTEXT=1
  ./SPM ingest full DB=stock_event_mining
  ./SPM ingest backfill CNINFO_BACKFILL_START=2025-01-01 CNINFO_BACKFILL_END=2026-01-01
  ./SPM event run DB=stock_event_mining LIMIT=20
  ./SPM research feature TIME_BUDGET=300 MAX_ROWS=200
  ./SPM research train DB=stock_event_mining
  ./SPM status db DB=stock_event_mining
  ./SPM status storage DB=stock_event_mining
  ./SPM status raw DB=stock_event_mining
  ./SPM status sources DB=stock_event_mining
  ./SPM status clean-stage DB=stock_event_mining --yes
EOF
}

dispatch_make() {
  local target="$1"
  shift
  exec make "$target" "$@"
}

normalize_make_args() {
  local group="$1"
  local command="$2"
  shift 2
  local normalized=()
  local arg
  for arg in "$@"; do
    if { [ "$group:$command" = "quality:clean-stage" ] || [ "$group:$command" = "status:clean-stage" ]; } && [ "$arg" = "--yes" ]; then
      normalized+=("YES=1")
    else
      normalized+=("$arg")
    fi
  done
  printf '%s\n' "${normalized[@]}"
}

is_group() {
  case "$1" in
    workflow|ingest|event|link|graph|research|status|collect|events|linking|quality) return 0 ;;
    *) return 1 ;;
  esac
}

is_group_command() {
  case "$1:$2" in
    workflow:full|workflow:trial) return 0 ;;
    ingest:live|ingest:history|ingest:backfill|ingest:full) return 0 ;;
    event:run|event:pending|event:reclassify|event:canonicalize) return 0 ;;
    link:run|link:universe|link:standard-industries|link:board-industries|link:stats|link:profiles|link:market|link:sentiment) return 0 ;;
    graph:run|graph:load|graph:propagate) return 0 ;;
    research:feature|research:train|research:controls) return 0 ;;
    status:summary|status:check|status:sample|status:delivery|status:db|status:storage|status:sources|status:raw|status:clean-stage) return 0 ;;
    collect:live|collect:history|collect:backfill-cninfo) return 0 ;;
    events:run|events:classify-pending|events:reclassify) return 0 ;;
    linking:run|linking:link-events|linking:company-universe|linking:standard-industries|linking:board-industries|linking:stats-import|linking:stats-load|linking:profiles-import|linking:profiles-load|linking:market-env|linking:sentiment-load) return 0 ;;
    graph:run|graph:load-relations|graph:propagate) return 0 ;;
    research:feature|research:train-samples|research:negative-samples) return 0 ;;
  quality:summary|quality:check|quality:sample|quality:delivery-status|quality:db|quality:storage|quality:storage-audit|quality:sources|quality:clean-stage) return 0 ;;
    *) return 1 ;;
  esac
}

resolve_shortcut() {
  case "$1" in
    full) echo "workflow full" ;;
    trial) echo "workflow trial" ;;
    history) echo "ingest history" ;;
    backfill) echo "ingest backfill" ;;
    raw-refresh) echo "ingest full" ;;
    event) echo "event run" ;;
    train) echo "research train" ;;
    controls) echo "research controls" ;;
    summary) echo "status summary" ;;
    sample) echo "status sample" ;;
    check) echo "status check" ;;
    db) echo "status db" ;;
    storage) echo "status storage" ;;
    raw) echo "status raw" ;;
    sources) echo "status sources" ;;
    clean-stage) echo "status clean-stage" ;;
    quality) echo "status summary" ;;
    collect-live) echo "collect live" ;;
    collect-history) echo "collect history" ;;
    backfill-cninfo) echo "collect backfill-cninfo" ;;
    events) echo "events run" ;;
    classify-pending) echo "events classify-pending" ;;
    reclassify) echo "events reclassify" ;;
    linking) echo "linking run" ;;
    link-events) echo "linking link-events" ;;
    company-universe) echo "linking company-universe" ;;
    standard-industries) echo "linking standard-industries" ;;
    board-industries) echo "linking board-industries" ;;
    stats-import) echo "linking stats-import" ;;
    stats-load) echo "linking stats-load" ;;
    profiles-import) echo "linking profiles-import" ;;
    profiles-load) echo "linking profiles-load" ;;
    market-env) echo "linking market-env" ;;
    sentiment-load) echo "linking sentiment-load" ;;
    graph) echo "graph run" ;;
    load-relations) echo "graph load-relations" ;;
    propagate) echo "graph propagate" ;;
    feature) echo "research feature" ;;
    train-samples) echo "research train-samples" ;;
    negative-samples) echo "research negative-samples" ;;
    *) return 1 ;;
  esac
}

if [ $# -eq 0 ]; then
  show_help
  exit 0
fi

if [ "$1" = "help" ] || [ "$1" = "--help" ] || [ "$1" = "-h" ]; then
  show_help
  exit 0
fi

group="$1"
shift

if is_group "$group"; then
  if [ $# -gt 0 ] && is_group_command "$group" "$1"; then
    :
  elif resolved="$(resolve_shortcut "$group" 2>/dev/null)"; then
    set -- $resolved "$@"
    group="$1"
    shift
  fi
elif resolved="$(resolve_shortcut "$group" 2>/dev/null)"; then
  set -- $resolved "$@"
  group="$1"
  shift
fi

if [ $# -eq 0 ]; then
  echo "Missing command for group: $group" >&2
  echo >&2
  show_help >&2
  exit 1
fi

command="$1"
shift

normalized_args=()
while IFS= read -r line; do
  normalized_args+=("$line")
done < <(normalize_make_args "$group" "$command" "$@")
set -- "${normalized_args[@]}"

case "$group:$command" in
  workflow:full) dispatch_make full "$@" ;;
  workflow:trial) dispatch_make trial "$@" ;;

  ingest:live) dispatch_make collect-live "$@" ;;
  ingest:history) dispatch_make collect-history "$@" ;;
  ingest:backfill) dispatch_make backfill-cninfo-fulltext "$@" ;;
  ingest:full) dispatch_make ingest-full-raw "$@" ;;

  event:run) dispatch_make events-run "$@" ;;
  event:pending) dispatch_make classify-pending "$@" ;;
  event:reclassify) dispatch_make reclassify-source "$@" ;;
  event:canonicalize) exec python3 src/cli/events.py canonicalize "$@" ;;

  link:run) dispatch_make linking-run "$@" ;;
  link:universe) dispatch_make company-universe "$@" ;;
  link:standard-industries) dispatch_make standard-industries "$@" ;;
  link:board-industries) dispatch_make board-industries "$@" ;;
  link:stats) dispatch_make stats-load "$@" ;;
  link:profiles) dispatch_make profiles-load "$@" ;;
  link:market) dispatch_make market-env "$@" ;;
  link:sentiment) dispatch_make sentiment-load "$@" ;;

  graph:load) dispatch_make load-relations "$@" ;;

  research:train) dispatch_make research-train-samples "$@" ;;
  research:controls) dispatch_make research-negative-samples "$@" ;;

  status:summary) dispatch_make quality-summary "$@" ;;
  status:check) dispatch_make quality-check "$@" ;;
  status:sample) dispatch_make quality-sample "$@" ;;
  status:delivery) dispatch_make delivery-status "$@" ;;
  status:db) dispatch_make db-summary "$@" ;;
  status:storage) dispatch_make db-storage-audit "$@" ;;
  status:sources) dispatch_make db-raw-source-audit "$@" ;;
  status:raw) dispatch_make db-raw-audit "$@" ;;
  status:clean-stage) dispatch_make db-stage-clean "$@" ;;

  collect:live) dispatch_make collect-live "$@" ;;
  collect:history) dispatch_make collect-history "$@" ;;
  collect:backfill-cninfo) dispatch_make backfill-cninfo-fulltext "$@" ;;

  events:run) dispatch_make events-run "$@" ;;
  events:classify-pending) dispatch_make classify-pending "$@" ;;
  events:reclassify) dispatch_make reclassify-source "$@" ;;

  linking:run) dispatch_make linking-run "$@" ;;
  linking:link-events) dispatch_make link-events "$@" ;;
  linking:company-universe) dispatch_make company-universe "$@" ;;
  linking:standard-industries) dispatch_make standard-industries "$@" ;;
  linking:board-industries) dispatch_make board-industries "$@" ;;
  linking:stats-import) dispatch_make stats-import "$@" ;;
  linking:stats-load) dispatch_make stats-load "$@" ;;
  linking:profiles-import) dispatch_make profiles-import "$@" ;;
  linking:profiles-load) dispatch_make profiles-load "$@" ;;
  linking:market-env) dispatch_make market-env "$@" ;;
  linking:sentiment-load) dispatch_make sentiment-load "$@" ;;

  graph:run) dispatch_make graph-run "$@" ;;
  graph:load-relations) dispatch_make load-relations "$@" ;;
  graph:propagate) dispatch_make propagate "$@" ;;

  research:feature) dispatch_make research-feature "$@" ;;
  research:train-samples) dispatch_make research-train-samples "$@" ;;
  research:negative-samples) dispatch_make research-negative-samples "$@" ;;

  quality:summary) dispatch_make quality-summary "$@" ;;
  quality:check) dispatch_make quality-check "$@" ;;
  quality:sample) dispatch_make quality-sample "$@" ;;
  quality:delivery-status) dispatch_make delivery-status "$@" ;;
  quality:db) dispatch_make db-summary "$@" ;;
  quality:storage|quality:storage-audit) dispatch_make db-storage-audit "$@" ;;
  quality:sources) dispatch_make db-raw-source-audit "$@" ;;
  quality:clean-stage) dispatch_make db-stage-clean "$@" ;;

  *)
    echo "Unknown command: $group $command" >&2
    echo >&2
    show_help >&2
    exit 1
    ;;
esac
